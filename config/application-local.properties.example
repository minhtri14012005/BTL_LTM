# Optional alternative to the shared config/application-local.properties.
# Copy this file only when you want to replace the provided local setup.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=quizz
DB_USER=quiz_app
DB_PASSWORD=

# Defaults: DB_HOST=127.0.0.1, DB_PORT=3306, DB_NAME=quizz.
# LAN example (replace the example address with your actual server address):
# SERVER_ADDRESS=0.0.0.0
# ALLOWED_ORIGINS=http://192.168.1.10:8080

# Optional immutable image storage; keep the same directory when restarting.
# QUIZ_IMAGE_DIRECTORY=./data/quiz-images
